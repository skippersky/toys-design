# Copy this file to .env.local for local development.
# Replace both Supabase placeholders with credentials from your Supabase project.
# Never commit real credentials or expose a service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
COMFYUI_HTTP_URL="http://127.0.0.1:8188"
COMFYUI_WS_URL="ws://127.0.0.1:8188"
# Default low-step model used by the bundled DirectML/CPU installer.
COMFYUI_CHECKPOINT_NAME="DreamShaper8_LCM.safetensors"
COMFYUI_SAMPLER_NAME="lcm"
COMFYUI_SCHEDULER="sgm_uniform"
AI_DEPLOYMENT_PROFILE="directml-lcm-lite"
NEXT_PUBLIC_AI_DEPLOYMENT_PROFILE="directml-lcm-lite"
NEXT_PUBLIC_AI_DEFAULT_STEPS="4"
NEXT_PUBLIC_AI_DEFAULT_CFG="2"
NEXT_PUBLIC_AI_SQUARE_WIDTH="384"
NEXT_PUBLIC_AI_SQUARE_HEIGHT="384"
NEXT_PUBLIC_AI_LANDSCAPE_WIDTH="512"
NEXT_PUBLIC_AI_LANDSCAPE_HEIGHT="384"
NEXT_PUBLIC_AI_PORTRAIT_WIDTH="384"
NEXT_PUBLIC_AI_PORTRAIT_HEIGHT="512"
